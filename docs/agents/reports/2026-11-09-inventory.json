{
  "baseline": "f7d05c8",
  "scope": "One-time repository inventory including relevant hidden and ignored files; excluded vendor/build/cache trees classified separately. No secret contents included.",
  "policies": {
    "entry": {
      "purpose": "Shared project entry point",
      "consumers": "Codex/Antigravity workspace discovery; Claude native import",
      "requiredPath": true,
      "action": "retain; add Phase 0B and canonical documentation link"
    },
    "claudeEntry": {
      "purpose": "Claude compatibility entry point",
      "consumers": "Claude instruction loader",
      "requiredPath": true,
      "action": "replace prose pointer with native @AGENTS.md import"
    },
    "sharedRules": {
      "purpose": "Shared project constraints",
      "consumers": "AGENTS references and Antigravity flat rule discovery",
      "requiredPath": true,
      "action": "retain flat paths; repair activation frontmatter; preserve custom body"
    },
    "canonicalSkills": {
      "purpose": "Canonical GitNexus workflows and task index",
      "consumers": "AGENTS task routing; .agents workspace skill discovery; Claude wrappers",
      "requiredPath": true,
      "action": "retain; no duplicate skill implementation or global install"
    },
    "claudeSkills": {
      "purpose": "Six compatibility skill entries",
      "consumers": "Claude .claude/skills discovery",
      "requiredPath": true,
      "action": "retain thin metadata/reference wrappers"
    },
    "impeccableConfig": {
      "purpose": "Impeccable project build preference",
      "consumers": "Installed impeccable context and doctor",
      "requiredPath": true,
      "action": "retain code buildPath; local override ignored"
    },
    "impeccableSidecar": {
      "purpose": "Design extensions beyond normative Markdown token primitives",
      "consumers": "Installed Impeccable design panel/doctor",
      "requiredPath": true,
      "action": "retain schema v2; timestamp-stale warning reported, no unverified regeneration"
    },
    "design": {
      "purpose": "Canonical root product/design context",
      "consumers": "Installed impeccable context/doctor resolves these root files",
      "requiredPath": true,
      "action": "retain root paths/content; normalize only PRODUCT local Markdown links"
    },
    "ledger": {
      "purpose": "Phase history and current blockers",
      "consumers": "Future agents; no tool-mandated old path found",
      "requiredPath": false,
      "action": "move to docs/agents/phase-ledger.md and update references"
    },
    "editor": {
      "purpose": "Local editor/runtime task preferences",
      "consumers": "VS Code; tasks are not executed by this audit",
      "requiredPath": true,
      "action": "retain ignored files; existing Firebase task is not verified as emulator-only"
    },
    "backups": {
      "purpose": "Backup, migration fixtures and historical verification evidence",
      "consumers": "Manual recovery/history; not authoritative for the current checkout",
      "requiredPath": false,
      "action": "retain byte-for-byte in ignored admin_backups; do not publish private data"
    },
    "scratch": {
      "purpose": "Existing manual app/content tooling, tests or snapshots; not an agent configuration source",
      "consumers": "Manual scripts; package test:offline invokes run_offline_tests.cjs; other live consumers unverified",
      "requiredPath": false,
      "action": "retain byte-for-byte; do not execute cloud/migration scripts or consolidate application files"
    },
    "projectDocs": {
      "purpose": "Existing user/application documentation",
      "consumers": "Developers; PRODUCT references and README-to-WIKI link",
      "requiredPath": false,
      "action": "retain; no parallel authoritative agent instructions added"
    },
    "ignore": {
      "purpose": "Exclude local machine state from source control",
      "consumers": "Git",
      "requiredPath": true,
      "action": "retain existing patterns; add only local Impeccable override and Firebase test runtime"
    },
    "secrets": {
      "purpose": "Private environment configuration",
      "consumers": "Application/local tools; content not read",
      "requiredPath": false,
      "action": "retain ignored; no content or secret hashes published"
    }
  },
  "excludedTrees": [
    {
      "path": ".git",
      "action": "retain; Git metadata or third-party/build/cache tree, not canonical agent configuration"
    },
    {
      "path": "dist",
      "action": "retain; Git metadata or third-party/build/cache tree, not canonical agent configuration"
    },
    {
      "path": "node_modules",
      "action": "retain; Git metadata or third-party/build/cache tree, not canonical agent configuration"
    },
    {
      "path": "public/pyodide",
      "action": "retain; Git metadata or third-party/build/cache tree, not canonical agent configuration"
    },
    {
      "path": "tools/firebase/node_modules",
      "action": "retain; Git metadata or third-party/build/cache tree, not canonical agent configuration"
    }
  ],
